{
  "rules": {
    "config": {
      "adminPin": {
        ".read": "auth.token.role === 'admin'",
        ".write": "(auth != null && !data.exists()) || auth.token.role === 'admin'",
        ".validate": "newData.isString() && newData.val().length >= 10"
      },
      "adminExists": {
        ".read": "auth != null",
        ".write": "(auth != null && !data.exists()) || auth.token.role === 'admin'",
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      }
    },
    "admins": {
      ".read": "auth.token.role === 'admin'",
      "$adminId": {
        ".write": "(auth != null && !root.child('admins').exists() && !root.child('config/adminPin').exists()) || auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['name', 'pin']) && newData.child('name').isString() && newData.child('pin').isString() && newData.child('pin').val().length >= 10"
      }
    },
    "tournaments": {
      ".read": true,
      "$tournamentId": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['name', 'status']) && newData.child('name').isString() && newData.child('status').isString()"
      }
    },
    "matches": {
      ".read": true,
      "$tournamentId": {
        ".write": "auth.token.role === 'admin' || auth.token.role === 'referee'",
        "$matchId": {
          ".validate": "newData.hasChildren(['tournamentId', 'status']) && (!data.exists() || !data.child('updatedAt').exists() || !newData.child('updatedAt').exists() || newData.child('updatedAt').val() > data.child('updatedAt').val())",
          "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'in_progress' || newData.val() === 'completed')" },
          "tournamentId": { ".validate": "newData.isString()" },
          "type": { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'individual' || newData.val() === 'team'))" },
          "$other": { ".validate": true }
        }
      }
    },
    "tournamentPlayers": {
      ".read": true,
      "$tournamentId": { ".write": "auth.token.role === 'admin'" }
    },
    "tournamentReferees": {
      ".read": true,
      "$tournamentId": { ".write": "auth.token.role === 'admin'" }
    },
    "teams": {
      ".read": true,
      "$tournamentId": { ".write": "auth.token.role === 'admin'" }
    },
    "schedule": {
      ".read": true,
      "$tournamentId": { ".write": "auth.token.role === 'admin'" }
    },
    "players": {
      ".read": true,
      "$playerId": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString()"
      }
    },
    "referees": {
      ".read": "auth != null",
      "$refereeId": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString()",
        "pin": {
          ".read": "auth.token.role === 'admin'",
          ".validate": "newData.isString()"
        }
      }
    },
    "courts": {
      ".read": true,
      "$courtId": {
        ".write": "auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString()"
      }
    },
    "notifications": {
      ".read": true,
      "$tournamentId": { ".write": "auth.token.role === 'admin'" }
    },
    "pushSubscriptions": {
      ".read": true,
      "$tokenKey": {
        ".write": "auth != null && (!data.exists() || !data.child('uid').exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['token', 'favoriteIds', 'platform', 'updatedAt', 'uid'])",
        "token": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "favoriteIds": { ".validate": true },
        "favoriteNames": { ".validate": true },
        "platform": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "pushNotifSent": {
      ".read": true,
      ".write": "auth != null"
    },
    "auth": {
      "rateLimits": {
        ".read": false,
        ".write": false
      },
      "loginRateLimits": {
        ".read": false,
        ".write": false
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
