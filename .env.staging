# Staging Firebase 프로젝트 설정
# 1. Firebase Console에서 새 프로젝트 생성 (예: showdown-staging)
# 2. Realtime Database 활성화 (asia-southeast1 권장)
# 3. Authentication > 익명 로그인 활성화
# 4. 아래 값을 프로젝트 설정에서 복사

VITE_FIREBASE_API_KEY=your-staging-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-staging-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-staging-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-staging-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder
VITE_FIREBASE_VAPID_KEY=your-staging-vapid-key
